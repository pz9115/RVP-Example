{
  "project": "RVP-Example",
  "repository": "https://github.com/pz9115/RVP-Example",
  "date": "2026-11-06",
  "purpose": "RV32 and RV64 P grayscale image SAD and block matching",
  "host_build": {"architecture": "x86_64", "os": "Ubuntu 24.04.2 LTS", "glibc": "2.39"},
  "targets": {
    "rv32": {"target": "riscv32-unknown-linux-gnu", "abi": "ilp32",
             "runtime_arch": "rv32imac", "toolchain": "toolchain-rv32",
             "compiler_backports": ["patches/rv32-wide-add.patch"]},
    "rv64": {"target": "riscv64-unknown-linux-gnu", "abi": "lp64d",
             "runtime_arch": "rv64gc", "toolchain": "toolchain"}
  },
  "p_version": "0.6 developed draft, not ratified",
  "scope": "C/static Linux demo; no C++, shared libgcc or thread-enabled libgcc",
  "versions": {"gcc": "16.1.0", "binutils": "2.47", "glibc": "2.43", "qemu": "11.1.50", "linux_uapi_headers": "6.16.0"},
  "qemu_configuration": "P-enabled RV32 and RV64 Linux-user, debug-stripped",
  "build_recipe": "scripts/build-toolchain.sh",
  "hardware_performance_measured": false
}
